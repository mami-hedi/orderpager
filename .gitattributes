# Fins de ligne : Git normalise le texte, mais les fichiers lus par Linux (serveur, Docker)
# doivent rester en LF même si le dépôt est cloné sous Windows (sinon : "bad interpreter: /bin/bash^M").
* text=auto
*.sh text eol=lf
Dockerfile text eol=lf
deploy/Caddyfile text eol=lf
docker-compose*.yml text eol=lf
