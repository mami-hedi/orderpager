# À copier en ".env" (à la racine du projet, sur le serveur), puis à remplir.
#
# Générer chaque secret avec :   openssl rand -hex 32
# N'utilisez ni le symbole $ ni de guillemets dans les valeurs : ils cassent la lecture du fichier.

# Adresse du site, SANS https://
#   test sans domaine : l'IP du serveur avec des tirets + .sslip.io   (ex. 203-0-113-10.sslip.io)
#   production        : votre domaine                                 (ex. bip.exemple.com)
DOMAIN=

# Mots de passe de MySQL (jamais exposé sur Internet, mais gardez-les forts)
MYSQL_ROOT_PASSWORD=
DB_PASSWORD=

# Clé de signature des connexions : 64 caractères hexadécimaux (openssl rand -hex 32)
JWT_SECRET=

# Mot de passe de la page /admin : 10 caractères minimum
ADMIN_PASSWORD=

# Notifications push (écran éteint) : voir DEPLOY.md, étape 8
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Mettre votre vraie adresse email (obligatoire pour les services push)
VAPID_SUBJECT=mailto:votre-email@exemple.com
